- name: icom_ptt
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nIcom CI-V T/R control (Embedded Python Block)\n\nMessage\
      \ inputs:\n  ptt  - bool/int, or a (name . value) pair as sent by QT GUI Toggle\
      \ Button.\n         True = transmit, False = receive.\n  cw   - text for the\
      \ radio's CW keyer (string, or pair from QT GUI Message Edit Box).\n       \
      \  Empty text aborts sending. Radio must be in CW mode with break-in on.\nMessage\
      \ outputs:\n  status - symbol: RX, LEAD, TX, TAIL or CW. After an error, for\
      \ error_hold_s seconds\n           it reads \"<state> | ERROR: ...\", then returns\
      \ to the plain state.\n  mute   - bool for a Mute block's set_mute port: True\
      \ except while TX audio is wanted.\n\nNeeds icom_civ.py and civ_controller.py\
      \ next to the .grc file (or set lib_dir).\nThe serial port is opened in start(),\
      \ not when GRC loads the block.\n\"\"\"\n\nimport sys\nimport threading\n\n\
      import pmt\nfrom gnuradio import gr\n\n\ndef _value(msg):\n    v = pmt.to_python(msg)\n\
      \    if isinstance(v, tuple) and len(v) == 2:     # (name . value) pair\n  \
      \      v = v[1]\n    return v\n\n\ndef _to_bool(v):\n    if isinstance(v, str):\n\
      \        return v.strip().lower() in (\"1\", \"true\", \"on\", \"tx\", \"pressed\"\
      )\n    return bool(v)\n\n\nclass blk(gr.basic_block):\n    \"\"\"Icom CI-V T/R\
      \ control: PTT with lead/tail timing, TX watchdog, CW keyer.\n\n    port: serial\
      \ device, e.g. /dev/serial/by-id/usb-Icom_Inc._IC-7300MK2_...-if00\n    radio_addr:\
      \ CI-V address (IC-7300MK2 default 0xB6, IC-7300 0x94)\n    lead_ms: delay after\
      \ confirmed TX before audio is un-muted\n    tail_ms: carrier hold after PTT\
      \ release\n    tx_timeout_s: watchdog, unkeys after this long in TX\n    cw_wpm:\
      \ keyer speed set on start and when changed (0 = leave radio setting)\n    usb_mod_level:\
      \ radio USB MOD Level %, set on start and when changed (-1 = leave)\n    error_hold_s:\
      \ how long an error stays visible in the status text\n    lib_dir: directory\
      \ holding icom_civ.py (blank = flowgraph directory)\n    \"\"\"\n\n    def __init__(self,\
      \ port='/dev/ttyACM0', baud=115200, radio_addr=0xB6,\n                 lead_ms=50,\
      \ tail_ms=50, tx_timeout_s=180, cw_wpm=0, usb_mod_level=-1,\n              \
      \   error_hold_s=5, lib_dir=''):\n        gr.basic_block.__init__(self, name='Icom\
      \ CI-V PTT', in_sig=None, out_sig=None)\n        self._cfg = dict(port=port,\
      \ baud=int(baud), radio_addr=int(radio_addr),\n                         lead=lead_ms\
      \ / 1000.0, tail=tail_ms / 1000.0,\n                         tx_timeout=float(tx_timeout_s),\
      \ lib_dir=lib_dir)\n        self._wpm = int(cw_wpm)\n        self._usbmod =\
      \ float(usb_mod_level)\n        self._civ = None\n        self._ctl = None\n\
      \        self._error_hold = float(error_hold_s)\n        self._status_lock =\
      \ threading.Lock()\n        self._state = 'RX'\n        self._error = ''\n \
      \       self._error_timer = None\n\n        self.message_port_register_in(pmt.intern('ptt'))\n\
      \        self.set_msg_handler(pmt.intern('ptt'), self._handle_ptt)\n       \
      \ self.message_port_register_in(pmt.intern('cw'))\n        self.set_msg_handler(pmt.intern('cw'),\
      \ self._handle_cw)\n        self.message_port_register_out(pmt.intern('status'))\n\
      \        self.message_port_register_out(pmt.intern('mute'))\n\n    # GRC turns\
      \ a property with a setter into a run-time callback (e.g. a QT GUI Range)\n\
      \    @property\n    def cw_wpm(self):\n        return self._wpm\n\n    @cw_wpm.setter\n\
      \    def cw_wpm(self, wpm):\n        self._wpm = int(wpm)\n        if self._ctl\
      \ is not None:\n            self._ctl.set_wpm(self._wpm)\n\n    @property\n\
      \    def usb_mod_level(self):\n        return self._usbmod\n\n    @usb_mod_level.setter\n\
      \    def usb_mod_level(self, pct):\n        self._usbmod = float(pct)\n    \
      \    if self._ctl is not None and self._usbmod >= 0:\n            self._ctl.set_usb_mod_level(self._usbmod)\n\
      \n    def start(self):\n        cfg = self._cfg\n        if cfg['lib_dir'] and\
      \ cfg['lib_dir'] not in sys.path:\n            sys.path.insert(0, cfg['lib_dir'])\n\
      \        import icom_civ\n        import civ_controller\n        self._civ =\
      \ icom_civ.CivPort(cfg['port'], cfg['baud'], cfg['radio_addr'])\n        try:\n\
      \            self._civ.open()\n        except Exception as e:\n            self._civ\
      \ = None\n            self._on_error(f\"cannot open {cfg['port']}: {e}\")\n\
      \            raise\n        self._ctl = civ_controller.TxController(\n     \
      \       self._civ, lead=cfg['lead'], tail=cfg['tail'], tx_timeout=cfg['tx_timeout'],\n\
      \            cw_wpm=self._wpm, usb_mod_level=self._usbmod, on_state=self._on_state,\n\
      \            on_mute=self._publish_mute, on_error=self._on_error)\n        self._ctl.start()\n\
      \        return True\n\n    def stop(self):\n        if self._ctl is not None:\n\
      \            self._ctl.close()           # always unkeys\n            self._ctl\
      \ = None\n        if self._civ is not None:\n            self._civ.close()\n\
      \            self._civ = None\n        with self._status_lock:\n           \
      \ if self._error_timer is not None:\n                self._error_timer.cancel()\n\
      \                self._error_timer = None\n        return True\n\n    def _handle_ptt(self,\
      \ msg):\n        if self._ctl is not None:\n            self._ctl.ptt(_to_bool(_value(msg)))\n\
      \n    def _handle_cw(self, msg):\n        if self._ctl is not None:\n      \
      \      v = _value(msg)\n            self._ctl.cw(v if isinstance(v, str) else\
      \ str(v))\n\n    # status text: current state, plus the latest error for error_hold_s\
      \ seconds\n    def _on_state(self, state):\n        with self._status_lock:\n\
      \            self._state = state\n            self._publish_status()\n\n   \
      \ def _on_error(self, text):\n        with self._status_lock:\n            self._error\
      \ = text\n            if self._error_timer is not None:\n                self._error_timer.cancel()\n\
      \            self._error_timer = threading.Timer(self._error_hold, self._clear_error)\n\
      \            self._error_timer.daemon = True\n            self._error_timer.start()\n\
      \            self._publish_status()\n\n    def _clear_error(self):\n       \
      \ with self._status_lock:\n            self._error = ''\n            self._error_timer\
      \ = None\n            self._publish_status()\n\n    def _publish_status(self):\n\
      \        text = f\"{self._state} | ERROR: {self._error}\" if self._error else\
      \ self._state\n        self.message_port_pub(pmt.intern('status'), pmt.intern(text))\n\
      \n    def _publish_mute(self, mute):\n        self.message_port_pub(pmt.intern('mute'),\
      \ pmt.from_bool(bool(mute)))\n"
    affinity: ''
    alias: ''
    baud: '115200'
    comment: ''
    cw_wpm: cw_wpm
    error_hold_s: '5'
    lead_ms: '50'
    lib_dir: ''''''
    maxoutbuf: '0'
    minoutbuf: '0'
    port: serial_port
    radio_addr: radio_addr
    tail_ms: '50'
    tx_timeout_s: '180'
    usb_mod_level: usb_mod_level
  states:
    _io_cache: '(''Icom CI-V PTT'', ''blk'', [(''port'', "''/dev/ttyACM0''"), (''baud'',
      ''115200''), (''radio_addr'', ''182''), (''lead_ms'', ''50''), (''tail_ms'',
      ''50''), (''tx_timeout_s'', ''180''), (''cw_wpm'', ''0''), (''usb_mod_level'',
      ''-1''), (''error_hold_s'', ''5''), (''lib_dir'', "''''")], [(''cw'', ''message'',
      1), (''ptt'', ''message'', 1)], [(''mute'', ''message'', 1), (''status'', ''message'',
      1)], ''Icom CI-V T/R control: PTT with lead/tail timing, TX watchdog, CW keyer.\n\nport:
      serial device, e.g. /dev/serial/by-id/usb-Icom_Inc._IC-7300MK2_...-if00\nradio_addr:
      CI-V address (IC-7300MK2 default 0xB6, IC-7300 0x94)\nlead_ms: delay after confirmed
      TX before audio is un-muted\ntail_ms: carrier hold after PTT release\ntx_timeout_s:
      watchdog, unkeys after this long in TX\ncw_wpm: keyer speed set on start and
      when changed (0 = leave radio setting)\nusb_mod_level: radio USB MOD Level %,
      set on start and when changed (-1 = leave)\nerror_hold_s: how long an error
      stays visible in the status text\nlib_dir: directory holding icom_civ.py (blank
      = flowgraph directory)\n'', [''cw_wpm'', ''usb_mod_level''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [420, 260]
    rotation: 0
    state: enabled
- name: rtty_mod
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nRTTY AFSK modulator (Embedded Python Block)\n\nStream output:\
      \ float audio at samp_rate (silence when idle).\nMessage inputs:\n  text   -\
      \ text to send (string, or pair from QT GUI Message Edit Box). Each message\
      \ is\n           sent on its own line. Text typed while sending is appended\
      \ to the same burst.\n  status - connect to the Icom CI-V PTT block's status\
      \ output.\nMessage outputs:\n  ptt    - connect to the Icom CI-V PTT block's\
      \ ptt input. The modulator keys the radio,\n           waits for TX, sends,\
      \ then releases PTT, but only if it did the keying.\n  info   - notices (unsupported\
      \ characters skipped, radio did not key, ...).\n\nRadio: LSB-D with mark 2125\
      \ / space 2295 Hz (normal on-air sense). For USB-D, swap them.\nNeeds rtty.py\
      \ next to the .grc file (or set lib_dir).\n\"\"\"\n\nimport sys\nimport threading\n\
      \nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\ndef _text(msg):\n\
      \    v = pmt.to_python(msg)\n    if isinstance(v, tuple) and len(v) == 2:\n\
      \        v = v[1]\n    return v if isinstance(v, str) else str(v)\n\n\nclass\
      \ blk(gr.sync_block):\n    \"\"\"RTTY AFSK modulator: Baudot, 45.45 baud, 170\
      \ Hz shift, automatic PTT.\n\n    preamble_s: mark idle after the radio reports\
      \ TX, before the text\n    postamble_s: mark tail after the text\n    release_delay_s:\
      \ wait after the last sample before releasing PTT; must cover the\n        audio\
      \ buffering between this block and the radio (about 0.4 s in the demo)\n   \
      \ \"\"\"\n\n    def __init__(self, samp_rate=48000, baud=45.45, mark_hz=2125.0,\
      \ space_hz=2295.0,\n                 amplitude=0.3, preamble_s=0.3, postamble_s=0.2,\
      \ release_delay_s=0.5,\n                 lib_dir=''):\n        gr.sync_block.__init__(self,\
      \ name='RTTY AFSK Mod', in_sig=None, out_sig=[np.float32])\n        self._cfg\
      \ = dict(samp_rate=float(samp_rate), baud=float(baud), mark=float(mark_hz),\n\
      \                         space=float(space_hz), amp=float(amplitude), pre=float(preamble_s),\n\
      \                         post=float(postamble_s), release=float(release_delay_s),\n\
      \                         lib_dir=lib_dir)\n        self._tx = None\n      \
      \  self._lock = threading.Lock()\n        self.message_port_register_in(pmt.intern('text'))\n\
      \        self.set_msg_handler(pmt.intern('text'), self._handle_text)\n     \
      \   self.message_port_register_in(pmt.intern('status'))\n        self.set_msg_handler(pmt.intern('status'),\
      \ self._handle_status)\n        self.message_port_register_out(pmt.intern('ptt'))\n\
      \        self.message_port_register_out(pmt.intern('info'))\n\n    def start(self):\n\
      \        c = self._cfg\n        if c['lib_dir'] and c['lib_dir'] not in sys.path:\n\
      \            sys.path.insert(0, c['lib_dir'])\n        import rtty\n       \
      \ gen = rtty.AfskGenerator(c['samp_rate'], c['baud'], c['mark'], c['space'],\
      \ c['amp'])\n        self._tx = rtty.RttyTransmitter(gen, self._request_ptt,\
      \ self._info, preamble_s=c['pre'],\n                                       \
      \ postamble_s=c['post'], release_delay_s=c['release'])\n        return True\n\
      \n    def stop(self):\n        with self._lock:\n            if self._tx is\
      \ not None:\n                self._tx.abort()        # releases PTT if this\
      \ block keyed it\n        return True\n\n    def _request_ptt(self, on):\n \
      \       self.message_port_pub(pmt.intern('ptt'), pmt.cons(pmt.intern('rtty'),\
      \ pmt.from_bool(bool(on))))\n\n    def _info(self, text):\n        print(text,\
      \ file=sys.stderr)\n        self.message_port_pub(pmt.intern('info'), pmt.intern(text))\n\
      \n    def _handle_text(self, msg):\n        with self._lock:\n            if\
      \ self._tx is not None:\n                self._tx.send(_text(msg))\n\n    def\
      \ _handle_status(self, msg):\n        with self._lock:\n            if self._tx\
      \ is not None:\n                self._tx.set_radio_state(_text(msg))\n\n   \
      \ def work(self, input_items, output_items):\n        out = output_items[0]\n\
      \        with self._lock:\n            if self._tx is None:\n              \
      \  out[:] = 0\n            else:\n                out[:] = self._tx.produce(len(out))\n\
      \        return len(out)\n"
    affinity: ''
    alias: ''
    amplitude: '0.3'
    baud: '45.45'
    comment: ''
    lib_dir: ''''''
    mark_hz: '2125.0'
    maxoutbuf: '1024'
    minoutbuf: '0'
    postamble_s: '0.2'
    preamble_s: '0.3'
    release_delay_s: '0.5'
    samp_rate: samp_rate
    space_hz: '2295.0'
  states:
    _io_cache: '(''RTTY AFSK Mod'', ''blk'', [(''samp_rate'', ''48000''), (''baud'',
      ''45.45''), (''mark_hz'', ''2125.0''), (''space_hz'', ''2295.0''), (''amplitude'',
      ''0.3''), (''preamble_s'', ''0.3''), (''postamble_s'', ''0.2''), (''release_delay_s'',
      ''0.5''), (''lib_dir'', "''''")], [(''text'', ''message'', 1), (''status'',
      ''message'', 1)], [(''0'', ''float'', 1), (''info'', ''message'', 1), (''ptt'',
      ''message'', 1)], ''RTTY AFSK modulator: Baudot, 45.45 baud, 170 Hz shift, automatic
      PTT.\n\npreamble_s: mark idle after the radio reports TX, before the text\npostamble_s:
      mark tail after the text\nrelease_delay_s: wait after the last sample before
      releasing PTT; must cover the\n    audio buffering between this block and the
      radio (about 0.4 s in the demo)\n'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [420, 700]
    rotation: 0
    state: enabled
