- name: console
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nConsole router (Embedded Python Block) for gr-webserver\n(https://github.com/duggabe/gr-webserver,\
      \ v2.1: ZMQ PUB/SUB).\n\nConnect:\n  ZMQ SUB Message Source (tcp://127.0.0.1:50251, bind False)\
      \ -> in\n  display -> ZMQ PUB Message Sink (tcp://127.0.0.1:50252, bind True)\n  cw   -> Icom CI-V\
      \ PTT block's cw input\n  radio -> Icom CI-V PTT block's radio input (optional: /cw sets up the\
      \ radio's CW decoder,\n           /rtty puts the radio in LSB-D)\n  rtty -> RTTY AFSK Mod's text\
      \ input\n  Icom CI-V PTT status -> status,  Icom CI-V PTT info and RTTY AFSK Mod info -> info\n\
      \  RTTY Demod text -> rx_rtty,  CW Decoder text -> rx_cw (optional: the demo reads CW on\n  the\
      \ radio's CW DECODE screen and leaves rx_cw unconnected)\n\nEach line typed in the console is sent\
      \ in the current mode. Commands:\n  /cw  /rtty   switch mode; CW is the default. /rtty (and starting\
      \ in RTTY) also puts the\n               radio in LSB-D; /cw (and starting in CW) puts it in CW\
      \ mode, ready for its\n               CW DECODE screen.\n  /stop        abort the current CW or\
      \ RTTY transmission (an empty line does the same)\n  /help        list the commands\nIf rx_rtty\
      \ / rx_cw are connected, the console shows received text for the current mode as\nit is. It always\
      \ shows errors and notices with a \"* \" in front. Radio state changes (TX / RX) go\nto gr-webserver's\
      \ /trace page instead: they are sent as \"TRACE: TX\" etc., and gr-webserver\nputs any line starting\
      \ with \"TRACE: \" on /trace rather than the console.\n\"\"\"\n\nimport threading\n\nimport pmt\n\
      from gnuradio import gr\n\nMODES = (\"RTTY\", \"CW\")\nHELP = [\"Type a line and press Enter to\
      \ send it in the current mode.\",\n        \"/rtty or /cw: switch mode (and the radio to LSB-D or\
      \ CW).  /stop or empty line: abort.  /help: this list.\"]\nQUIET_STATES = (\"LEAD\", \"TAIL\") \
      \    # brief PTT sequencing states, not worth showing\nTRACE = \"TRACE: \"                   # gr-webserver\
      \ shows these lines on /trace, not the console\n\n\ndef _text(msg):\n    v = pmt.to_python(msg)\n\
      \    if isinstance(v, tuple) and len(v) == 2:\n        v = v[1]\n    if isinstance(v, (bytes, bytearray)):\n\
      \        v = bytes(v).decode(\"utf-8\", \"replace\")\n    return v if isinstance(v, str) else str(v)\n\
      \n\nclass blk(gr.basic_block):\n    \"\"\"Routes gr-webserver console lines to CW or RTTY and shows\
      \ radio status.\n\n    mode: 'CW' or 'RTTY' at start (the radio is set up as /cw or /rtty would);\
      \ change it\n          from the console with /cw or /rtty.\n    \"\"\"\n\n    def __init__(self,\
      \ mode='CW'):\n        gr.basic_block.__init__(self, name='Console Router', in_sig=None, out_sig=None)\n\
      \        m = str(mode).upper()\n        self._mode = m if m in MODES else MODES[0]\n        self._state\
      \ = None\n        self._error = None\n        self._greet = threading.Timer(0, lambda: None)\n \
      \       self._switched = False          # /cw or /rtty typed since start\n        for port, handler\
      \ in ((\"in\", self._handle_in), (\"status\", self._handle_status),\n                          \
      \    (\"info\", self._handle_info), (\"rx_rtty\", self._handle_rx_rtty),\n                     \
      \         (\"rx_cw\", self._handle_rx_cw)):\n            self.message_port_register_in(pmt.intern(port))\n\
      \            self.set_msg_handler(pmt.intern(port), handler)\n        for port in (\"display\",\
      \ \"cw\", \"rtty\", \"radio\"):\n            self.message_port_register_out(pmt.intern(port))\n\n\
      \    def start(self):\n        # delayed: ZMQ PUB drops messages until the console's SUB socket\
      \ has connected\n        self._switched = False\n        self._greet = threading.Timer(1.0, self._greeting,\
      \ (self._mode,))\n        self._greet.daemon = True\n        self._greet.start()\n        return\
      \ True\n\n    def stop(self):\n        self._greet.cancel()\n        return True\n\n    def _greeting(self,\
      \ mode):\n        self._note(f\"Mode {mode}. Type /help for commands.\")\n        if not self._switched:\n\
      \            self._setup_radio()\n\n    def _setup_radio(self):\n        cmd = {\"CW\": \"CW DECODE\"\
      , \"RTTY\": \"LSB-D\"}[self._mode]\n        self.message_port_pub(pmt.intern(\"radio\"), pmt.intern(cmd))\n\
      \n    def _show(self, line):\n        # gr-webserver shows one line per message and renders it as\
      \ HTML\n        line = line.replace(\"\\r\", \" \").replace(\"\\n\", \" \").replace(\"&\", \"&amp;\"\
      ).replace(\"<\", \"&lt;\")\n        self.message_port_pub(pmt.intern(\"display\"), pmt.intern(line))\n\
      \n    def _note(self, line):\n        self._show(\"* \" + line)\n\n    def _trace(self, line):\n\
      \        self._show(TRACE + line)\n\n    def _send(self, mode, text):\n        self.message_port_pub(pmt.intern(mode.lower()),\
      \ pmt.intern(text))\n\n    def _handle_in(self, msg):\n        line = _text(msg).strip()\n     \
      \   cmd = line.lower()\n        if cmd in (\"/rtty\", \"/cw\"):\n            self._mode = cmd[1:].upper()\n\
      \            self._switched = True\n            self._note(f\"Mode {self._mode}\")\n           \
      \ self._setup_radio()\n        elif cmd in (\"\", \"/stop\"):\n            for m in MODES:\n   \
      \             self._send(m, \"\")              # empty text = abort, in both blocks\n          \
      \  self._note(\"Stop\")\n        elif cmd == \"/help\":\n            for h in HELP:\n          \
      \      self._note(h)\n        elif cmd.startswith(\"/\"):\n            self._note(f\"Unknown command\
      \ {line}. Type /help.\")\n        else:\n            self._send(self._mode, line)\n\n    def _handle_status(self,\
      \ msg):\n        state, _, err = _text(msg).partition(\" | \")\n        if err.startswith(\"ERROR:\
      \ \"):\n            err = err[len(\"ERROR: \"):]\n        if err and err != self._error:\n     \
      \       self._note(f\"ERROR: {err}\")\n        self._error = err or None\n        if state != self._state\
      \ and state not in QUIET_STATES:\n            self._trace(\"TX (CW keyer)\" if state == \"CW\" else\
      \ state)\n            self._state = state\n\n    def _handle_info(self, msg):\n        self._note(_text(msg))\n\
      \n    def _handle_rx_rtty(self, msg):\n        if self._mode == \"RTTY\":\n            self._show(_text(msg))\n\
      \n    def _handle_rx_cw(self, msg):\n        if self._mode == \"CW\":\n            self._show(_text(msg))\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    mode: '''CW'''
  states:
    _io_cache: '(''Console Router'', ''blk'', [(''mode'', "''CW''")], [(''rx_cw'', ''message'', 1), (''rx_rtty'',
      ''message'', 1), (''in'', ''message'', 1), (''info'', ''message'', 1), (''status'', ''message'',
      1)], [(''radio'', ''message'', 1), (''rtty'', ''message'', 1), (''cw'', ''message'', 1), (''display'',
      ''message'', 1)], "Routes gr-webserver console lines to CW or RTTY and shows radio status.\n\nmode:
      ''CW'' or ''RTTY'' at start (the radio is set up as /cw or /rtty would); change it\n      from the
      console with /cw or /rtty.\n", [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 456
    - 664.0
    rotation: 0
    state: enabled
