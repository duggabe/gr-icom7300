- name: rtty_demod
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nRTTY demodulator (Embedded Python Block)\n\nStream input: float audio at samp_rate\
      \ (the radio's USB audio, via an Audio Source).\nMessage inputs:\n  status - connect to the Icom\
      \ CI-V PTT block's status output. Decoding pauses while\n           the radio is not in RX, and\
      \ for holdoff_s after it returns to RX.\nMessage outputs:\n  text    - received text, one display\
      \ line per message (connect to the Console\n            Router's rx_rtty input).\n  preview - the\
      \ last preview_chars received characters (line breaks as spaces), sent\n            as each character\
      \ arrives (connect to a QT GUI Message Edit Box's val input).\n\nRadio: LSB-D, tuned so the signal's\
      \ mark/space fall on 2125/2295 Hz. Tick reverse for an\ninverted signal. Needs rtty.py next to the\
      \ .grc file (or set lib_dir).\n\"\"\"\n\nimport sys\nimport threading\nimport time\n\nimport numpy\
      \ as np\nimport pmt\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"RTTY receiver:\
      \ 45.45 baud, 170 Hz shift, Baudot (US-TTY figures).\n\n    reverse: swap mark and space (can be\
      \ changed while running)\n    squelch: minimum character quality 0-1 (0 = off; 0.6 hides most noise)\n\
      \    usos: unshift to letters on space\n    line_width: wrap received text at this many characters\n\
      \    holdoff_s: keep decoding paused this long after the radio returns to RX\n    preview_chars:\
      \ length of the scrolling preview (0 = no preview messages)\n    \"\"\"\n\n    def __init__(self,\
      \ samp_rate=48000, baud=45.45, mark_hz=2125.0, space_hz=2295.0,\n                 reverse=False,\
      \ squelch=0.6, usos=True, line_width=64, holdoff_s=0.5,\n                 preview_chars=80, lib_dir=''):\n\
      \        gr.sync_block.__init__(self, name='RTTY Demod', in_sig=[np.float32], out_sig=None)\n  \
      \      self._cfg = dict(samp_rate=float(samp_rate), baud=float(baud), mark=float(mark_hz),\n   \
      \                      space=float(space_hz), squelch=float(squelch), usos=bool(usos),\n       \
      \                  width=int(line_width), lib_dir=lib_dir)\n        self._reverse = bool(reverse)\n\
      \        self._holdoff = float(holdoff_s)\n        self._preview_chars = int(preview_chars)\n  \
      \      self._preview = \"\"\n        self._demod = None\n        self._lines = None\n        self._rx\
      \ = True\n        self._resume = 0.0\n        self._lock = threading.Lock()\n        self.message_port_register_in(pmt.intern('status'))\n\
      \        self.set_msg_handler(pmt.intern('status'), self._handle_status)\n        self.message_port_register_out(pmt.intern('text'))\n\
      \        self.message_port_register_out(pmt.intern('preview'))\n\n    @property\n    def reverse(self):\n\
      \        return self._reverse\n\n    @reverse.setter\n    def reverse(self, value):\n        self._reverse\
      \ = bool(value)\n        with self._lock:\n            if self._demod is not None:\n           \
      \     self._demod.reverse = self._reverse\n\n    def start(self):\n        c = self._cfg\n     \
      \   if c['lib_dir'] and c['lib_dir'] not in sys.path:\n            sys.path.insert(0, c['lib_dir'])\n\
      \        import rtty\n        with self._lock:\n            self._demod = rtty.RttyDemodulator(c['samp_rate'],\
      \ c['baud'], c['mark'], c['space'],\n                                               self._reverse,\
      \ c['squelch'], c['usos'])\n            self._lines = rtty.LineAssembler(c['width'])\n        return\
      \ True\n\n    def _handle_status(self, msg):\n        v = pmt.to_python(msg)\n        state = str(v[1]\
      \ if isinstance(v, tuple) else v)\n        rx = state.startswith(\"RX\")\n        with self._lock:\n\
      \            if rx and not self._rx:\n                self._resume = time.monotonic() + self._holdoff\n\
      \            self._rx = rx\n\n    def _publish(self, lines):\n        for line in lines:\n     \
      \       self.message_port_pub(pmt.intern('text'), pmt.intern(line))\n\n    def work(self, input_items,\
      \ output_items):\n        audio = input_items[0]\n        now = time.monotonic()\n        text =\
      \ \"\"\n        with self._lock:\n            if self._demod is None:\n                return len(audio)\n\
      \            if not self._rx or now < self._resume:\n                self._demod.reset()       \
      \     # own transmission: nothing to decode\n                lines = self._lines.poll(now + self._lines.idle)\
      \   # flush what we had\n            else:\n                text = self._demod.receive(audio)\n\
      \                lines = self._lines.feed(text, now) + self._lines.poll(now)\n        self._publish(lines)\n\
      \        if text and self._preview_chars > 0:\n            chars = text.replace(\"\\r\", \"\").replace(\"\
      \\n\", \" \")\n            if chars:\n                self._preview = (self._preview + chars)[-self._preview_chars:]\n\
      \                self.message_port_pub(pmt.intern('preview'), pmt.intern(self._preview))\n     \
      \   return len(audio)\n"
    affinity: ''
    alias: ''
    baud: '45.45'
    comment: ''
    holdoff_s: '0.5'
    lib_dir: ''''''
    line_width: '64'
    mark_hz: '2125.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    preview_chars: '80'
    reverse: rx_reverse
    samp_rate: samp_rate
    space_hz: '2295.0'
    squelch: '0.6'
    usos: 'True'
  states:
    _io_cache: '(''RTTY Demod'', ''blk'', [(''samp_rate'', ''48000''), (''baud'', ''45.45''), (''mark_hz'',
      ''2125.0''), (''space_hz'', ''2295.0''), (''reverse'', ''False''), (''squelch'', ''0.6''), (''usos'',
      ''True''), (''line_width'', ''64''), (''holdoff_s'', ''0.5''), (''preview_chars'', ''80''), (''lib_dir'',
      "''''")], [(''0'', ''float'', 1), (''status'', ''message'', 1)], [(''preview'', ''message'', 1),
      (''text'', ''message'', 1)], ''RTTY receiver: 45.45 baud, 170 Hz shift, Baudot (US-TTY figures).\n\nreverse:
      swap mark and space (can be changed while running)\nsquelch: minimum character quality 0-1 (0 =
      off; 0.6 hides most noise)\nusos: unshift to letters on space\nline_width: wrap received text at
      this many characters\nholdoff_s: keep decoding paused this long after the radio returns to RX\npreview_chars:
      length of the scrolling preview (0 = no preview messages)\n'', [''reverse''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 448
    - 868.0
    rotation: 0
    state: enabled
- name: rtty_mod
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nRTTY AFSK modulator (Embedded Python Block)\n\nStream output: float audio at\
      \ samp_rate (silence when idle).\nMessage inputs:\n  text   - text to send (string, or pair from\
      \ QT GUI Message Edit Box). Each message is\n           sent on its own line. Text typed while sending\
      \ is appended to the same burst.\n           Empty text aborts the transmission.\n  status - connect\
      \ to the Icom CI-V PTT block's status output.\nMessage outputs:\n  ptt    - connect to the Icom\
      \ CI-V PTT block's ptt input. The modulator keys the radio,\n           waits for TX, sends, then\
      \ releases PTT, but only if it did the keying.\n  info   - notices (unsupported characters skipped,\
      \ radio did not key, ...).\n\nRadio: LSB-D with mark 2125 / space 2295 Hz (normal on-air sense).\
      \ For USB-D, swap them.\nNeeds rtty.py next to the .grc file (or set lib_dir).\n\"\"\"\n\nimport\
      \ sys\nimport threading\n\nimport numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\ndef _text(msg):\n\
      \    v = pmt.to_python(msg)\n    if isinstance(v, tuple) and len(v) == 2:\n        v = v[1]\n  \
      \  return v if isinstance(v, str) else str(v)\n\n\nclass blk(gr.sync_block):\n    \"\"\"RTTY AFSK\
      \ modulator: Baudot, 45.45 baud, 170 Hz shift, automatic PTT.\n\n    preamble_s: mark idle after\
      \ the radio reports TX, before the text\n    postamble_s: mark tail after the text\n    release_delay_s:\
      \ wait after the last sample before releasing PTT; must cover the\n        audio buffering between\
      \ this block and the radio (about 0.4 s in the demo)\n    \"\"\"\n\n    def __init__(self, samp_rate=48000,\
      \ baud=45.45, mark_hz=2125.0, space_hz=2295.0,\n                 amplitude=0.3, preamble_s=0.3,\
      \ postamble_s=0.2, release_delay_s=0.5,\n                 lib_dir=''):\n        gr.sync_block.__init__(self,\
      \ name='RTTY AFSK Mod', in_sig=None, out_sig=[np.float32])\n        self._cfg = dict(samp_rate=float(samp_rate),\
      \ baud=float(baud), mark=float(mark_hz),\n                         space=float(space_hz), amp=float(amplitude),\
      \ pre=float(preamble_s),\n                         post=float(postamble_s), release=float(release_delay_s),\n\
      \                         lib_dir=lib_dir)\n        self._tx = None\n        self._lock = threading.Lock()\n\
      \        self.message_port_register_in(pmt.intern('text'))\n        self.set_msg_handler(pmt.intern('text'),\
      \ self._handle_text)\n        self.message_port_register_in(pmt.intern('status'))\n        self.set_msg_handler(pmt.intern('status'),\
      \ self._handle_status)\n        self.message_port_register_out(pmt.intern('ptt'))\n        self.message_port_register_out(pmt.intern('info'))\n\
      \n    def start(self):\n        c = self._cfg\n        if c['lib_dir'] and c['lib_dir'] not in sys.path:\n\
      \            sys.path.insert(0, c['lib_dir'])\n        import rtty\n        gen = rtty.AfskGenerator(c['samp_rate'],\
      \ c['baud'], c['mark'], c['space'], c['amp'])\n        self._tx = rtty.RttyTransmitter(gen, self._request_ptt,\
      \ self._info, preamble_s=c['pre'],\n                                        postamble_s=c['post'],\
      \ release_delay_s=c['release'])\n        return True\n\n    def stop(self):\n        with self._lock:\n\
      \            if self._tx is not None:\n                self._tx.abort()        # releases PTT if\
      \ this block keyed it\n        return True\n\n    def _request_ptt(self, on):\n        self.message_port_pub(pmt.intern('ptt'),\
      \ pmt.cons(pmt.intern('rtty'), pmt.from_bool(bool(on))))\n\n    def _info(self, text):\n       \
      \ print(text, file=sys.stderr)\n        self.message_port_pub(pmt.intern('info'), pmt.intern(text))\n\
      \n    def _handle_text(self, msg):\n        with self._lock:\n            if self._tx is not None:\n\
      \                self._tx.send(_text(msg))\n\n    def _handle_status(self, msg):\n        with self._lock:\n\
      \            if self._tx is not None:\n                self._tx.set_radio_state(_text(msg))\n\n\
      \    def work(self, input_items, output_items):\n        out = output_items[0]\n        with self._lock:\n\
      \            if self._tx is None:\n                out[:] = 0\n            else:\n             \
      \   out[:] = self._tx.produce(len(out))\n        return len(out)\n"
    affinity: ''
    alias: ''
    amplitude: '0.3'
    baud: '45.45'
    comment: ''
    lib_dir: ''''''
    mark_hz: '2125.0'
    maxoutbuf: '1024'
    minoutbuf: '0'
    postamble_s: '0.2'
    preamble_s: '0.3'
    release_delay_s: '0.5'
    samp_rate: samp_rate
    space_hz: '2295.0'
  states:
    _io_cache: '(''RTTY AFSK Mod'', ''blk'', [(''samp_rate'', ''48000''), (''baud'', ''45.45''), (''mark_hz'',
      ''2125.0''), (''space_hz'', ''2295.0''), (''amplitude'', ''0.3''), (''preamble_s'', ''0.3''), (''postamble_s'',
      ''0.2''), (''release_delay_s'', ''0.5''), (''lib_dir'', "''''")], [(''status'', ''message'', 1),
      (''text'', ''message'', 1)], [(''0'', ''float'', 1), (''info'', ''message'', 1), (''ptt'', ''message'',
      1)], ''RTTY AFSK modulator: Baudot, 45.45 baud, 170 Hz shift, automatic PTT.\n\npreamble_s: mark
      idle after the radio reports TX, before the text\npostamble_s: mark tail after the text\nrelease_delay_s:
      wait after the last sample before releasing PTT; must cover the\n    audio buffering between this
      block and the radio (about 0.4 s in the demo)\n'', [])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 792
    - 620.0
    rotation: 0
    state: enabled
